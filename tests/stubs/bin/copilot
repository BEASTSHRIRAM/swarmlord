#!/usr/bin/env bash
# Generic stub agent CLI for tests. Behaviour is controlled by env:
#   STUB_MODE_<NAME> / STUB_MODE : ok|quota|auth|permission|empty|fail
#   STUB_RC                      : force this exit code on a run
#   STUB_WRITE + STUB_CONTENT    : write a file (relative to cwd) during a run
name="$(basename "$0")"
key="$(printf '%s' "$name" | tr 'a-z-' 'A-Z_')"
eval "mode=\${STUB_MODE_$key:-\${STUB_MODE:-ok}}"
case "${1:-}" in
  --version|-v|version) echo "$name 1.0.0"; exit 0 ;;
  login|whoami|status|usage|models|auth)
    case "$name" in
      agy) echo "gemini-stub-model" ;;
      opencode) echo "stub-provider (api key)" ;;
      *) echo "authenticated stub user" ;;
    esac
    exit "${STUB_AUTH_RC:-0}" ;;
esac
# headless run
if [ -n "${STUB_RC:-}" ]; then echo "stub forced failure" >&2; exit "$STUB_RC"; fi
case "$mode" in
  quota) echo "Error: quota exceeded — rate limit (429) too many requests" >&2; exit 1 ;;
  auth) echo "Error: not authenticated — login required (401 unauthorized)" >&2; exit 1 ;;
  permission) echo "Error: permission denied — tool call was denied" >&2; exit 1 ;;
  empty) exit 0 ;;
  fail) echo "Error: boom, an unclassifiable failure" >&2; exit 1 ;;
esac
echo "stub reply from $name: task done"
if [ -n "${STUB_WRITE:-}" ]; then printf '%s\n' "${STUB_CONTENT:-stub change}" > "$STUB_WRITE"; fi
exit 0
